# Bacchat Cloud configuration. Copy to .env and adjust.
PORT=8080
HOST=0.0.0.0
# Where the SQLite database lives (mount a volume here).
DATA_DIR=/data
# Per-account storage cap in bytes (default 500 MB).
STORAGE_CAP_BYTES=524288000
# Largest single blob (decoded ciphertext) in bytes (default 10 MB).
MAX_BLOB_BYTES=10485760
MAX_DEVICES_PER_ACCOUNT=20
# Requests per minute per client IP (0 disables).
RATE_LIMIT_PER_MIN=120
# New accounts or devices per hour per client IP (0 disables).
REGISTER_LIMIT_PER_HOUR=10
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false
LOG_LEVEL=info

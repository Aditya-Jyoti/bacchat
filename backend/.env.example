# Copy to .env next to docker-compose.prod.yml.
# The public name of your server. Its DNS must point here before the first start.
BACCHAT_DOMAIN=sync.example.com

# Optional limits (defaults shown).
STORAGE_CAP_BYTES=524288000
MAX_BLOB_BYTES=10485760
MAX_DEVICES_PER_ACCOUNT=20
RATE_LIMIT_PER_MIN=120
REGISTER_LIMIT_PER_HOUR=10
LOG_LEVEL=info
